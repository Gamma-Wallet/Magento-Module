<?php
/**
 * The Gamma Wallet box: the reward QR code, the store-credit QR code with its countdown, or a note.
 * Asks this shop (never Gamma) every 5 seconds through gamma_wallet.js.
 *
 * @var \Gamma\Wallet\Block\Box $block
 * @var \Magento\Framework\Escaper $escaper
 */
$box = $block->getBox();
if (!$box) {
    return;
}
$logo = $block->getViewFileUrl('Gamma_Wallet::images/gamma-logo.png');
?>
<link rel="stylesheet" href="<?= $escaper->escapeUrl($block->getViewFileUrl('Gamma_Wallet::css/gamma_wallet.css')) ?>">
<?php if ($box['kind'] === 'reward'): ?>
<section class="gamma-wallet-box" data-kind="reward" data-texts="<?= $escaper->escapeHtmlAttr($block->getTexts()) ?>" data-status-url="<?= $escaper->escapeUrl($box['status_url']) ?>" data-poll="<?= $box['claimed'] ? '0' : '1' ?>">
  <div class="gw-card<?= $box['claimed'] ? ' gw-is-done' : '' ?>">
    <div class="gw-qr-col">
      <div class="gamma-wallet-qr gw-qr-tile"><img src="<?= $escaper->escapeUrl($box['qr']) ?>" width="200" height="200" alt="QR"></div>
      <div class="gw-check" aria-hidden="true">&#10003;</div>
    </div>
    <div class="gw-body">
      <p class="gamma-wallet-logo"><img src="<?= $escaper->escapeUrl($logo) ?>" alt="Gamma Wallet" height="22"></p>
      <h2 class="gamma-wallet-title"><?= $escaper->escapeHtml(__('Collect your reward')) ?></h2>
      <p class="gw-lead gw-when-waiting"><?= $escaper->escapeHtml(__('This order earns you a reward. Add it to your Gamma Wallet in a few seconds.')) ?></p>
      <ol class="gw-steps gw-when-waiting">
        <li><?= $escaper->escapeHtml(__('Open the Gamma Wallet app')) ?></li>
        <li><?= $escaper->escapeHtml(__('Scan this code')) ?></li>
        <li><?= $escaper->escapeHtml(__('The reward is added to your wallet')) ?></li>
      </ol>
      <a class="gamma-wallet-open gw-button gw-when-waiting" href="<?= $escaper->escapeUrl($box['link']) ?>"><?= $escaper->escapeHtml(__('On your phone? Open in Gamma Wallet')) ?></a>
      <p class="gamma-wallet-done gw-done"<?= $box['claimed'] ? '' : ' hidden' ?>><?= $escaper->escapeHtml(__('Reward collected. Thank you!')) ?></p>
    </div>
  </div>
</section>
<?php elseif ($box['kind'] === 'credit'): ?>
<section class="gamma-wallet-box gamma-wallet-credit" data-kind="credit" data-texts="<?= $escaper->escapeHtmlAttr($block->getTexts()) ?>" data-status-url="<?= $escaper->escapeUrl($box['status_url']) ?>" data-new-code-url="<?= $escaper->escapeUrl($box['new_code_url']) ?>" data-seconds-left="<?= (int)$box['seconds'] ?>" data-poll="1">
  <div class="gw-card">
    <div class="gw-qr-col">
      <div class="gamma-wallet-qr gw-qr-tile"><img class="gamma-wallet-qr-img" src="<?= /* data:image/png;base64 URL built by the module; escapeUrl would strip it */ $escaper->escapeHtmlAttr($box['qr']) ?>" width="220" height="220" alt="QR"<?= $box['qr'] && $box['seconds'] > 0 ? '' : ' hidden' ?>></div>
      <div class="gw-timer" aria-hidden="true"><span class="gw-timer-bar"></span></div>
      <p class="gamma-wallet-countdown gw-countdown" aria-live="polite"></p>
      <div class="gw-check" aria-hidden="true">&#10003;</div>
    </div>
    <div class="gw-body">
      <p class="gamma-wallet-logo"><img src="<?= $escaper->escapeUrl($logo) ?>" alt="Gamma Wallet" height="22"></p>
      <h2 class="gamma-wallet-title"><?= $escaper->escapeHtml(__('Use your store credits')) ?></h2>
      <p class="gw-lead"><?= $escaper->escapeHtml(__('Settle the whole order (%1) with the store credits you hold at our shop.', $box['total'])) ?></p>
      <ol class="gw-steps gw-when-waiting">
        <li><?= $escaper->escapeHtml(__('Open the Gamma Wallet app')) ?></li>
        <li><?= $escaper->escapeHtml(__('Scan this code before the time runs out')) ?></li>
        <li><?= $escaper->escapeHtml(__('Confirm, and this page updates by itself')) ?></li>
      </ol>
      <a class="gamma-wallet-open gw-button gw-when-waiting" href="<?= $escaper->escapeUrl($box['link']) ?>"><?= $escaper->escapeHtml(__('On your phone? Open in Gamma Wallet')) ?></a>
      <button type="button" class="gamma-wallet-new-code gw-button" hidden><?= $escaper->escapeHtml(__('Show a new code')) ?></button>
      <p class="gamma-wallet-done gw-done" hidden></p>
    </div>
  </div>
</section>
<?php else: ?>
<p class="gamma-wallet-note"><?= $escaper->escapeHtml($box['note']) ?></p>
<?php endif; ?>
<script src="<?= $escaper->escapeUrl($block->getViewFileUrl('Gamma_Wallet::js/gamma_wallet.js')) ?>"></script>

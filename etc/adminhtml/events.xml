<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Saving the payment settings checks the connection at once. -->
    <event name="admin_system_config_changed_section_payment">
        <observer name="gamma_wallet_check_connection" instance="Gamma\Wallet\Observer\CheckConnectionOnSave"/>
    </event>
</config>

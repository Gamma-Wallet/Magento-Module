<?xml version="1.0"?>
<!-- The reward QR code image is loaded from the Gamma Integration API (order pages and the admin order page). -->
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="img-src">
            <values>
                <value id="gamma_wallet_integration" type="host">integration.gamma-wallet.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
